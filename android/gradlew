#!/bin/sh
# ---------------------------------------------------------------------------
# Minimal Gradle launcher (posix). Equivalent behaviour to the Gradle wrapper:
# it downloads the distribution pinned in gradle/wrapper/gradle-wrapper.properties
# into ~/.gradle/wrapper/dists and executes it. This keeps the repository free of
# the large wrapper JAR while remaining fully reproducible in CI.
# ---------------------------------------------------------------------------
set -e

APP_HOME=$(cd "$(dirname "$0")" && pwd)
PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

dist_url=$(sed -n 's/^distributionUrl=//p' "$PROPS" | sed 's/\\:/:/g')
dist_name=$(basename "$dist_url" .zip)
gradle_dir="$HOME/.gradle/wrapper/dists/$dist_name"

if [ ! -x "$gradle_dir/$dist_name/bin/gradle" ]; then
    echo "Downloading $dist_url"
    mkdir -p "$gradle_dir"
    tmp_zip="$gradle_dir/dist.zip"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$dist_url" -o "$tmp_zip"
    else
        wget -q "$dist_url" -O "$tmp_zip"
    fi
    unzip -q -o "$tmp_zip" -d "$gradle_dir"
    rm -f "$tmp_zip"
    chmod +x "$gradle_dir/$dist_name/bin/gradle"
fi

exec "$gradle_dir/$dist_name/bin/gradle" -p "$APP_HOME" "$@"

  @typing character="abigail" duration="2"
  @message id="mm_p4_f2_msg" chat="dm_abigail" sender="abigail" text="package only. i typed out what the guy was saying. i could not sleep so i listened 10 times."
  @image id="mm_p4_f2_img" chat="dm_abigail" sender="abigail" file="doc_abigail_audio_transcript.jpg" caption="Abigail transcript - hallway scream, get out of my head, stop looking at me, 00:47 AM"
  @typing character="abigail" duration="2"

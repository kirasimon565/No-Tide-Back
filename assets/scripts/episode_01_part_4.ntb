  @ui open="dm_kai"
  @typing character="kai" duration="2"
  @message id="mm_p4_f5_msg" chat="dm_kai" sender="kai" text="package only. this is my hand drawn map of the southwest inlet. i drew it on my boat."
  @image id="mm_p4_f5_img" chat="dm_kai" sender="kai" file="doc_kai_inlet_map.jpg" caption="Kai inlet map - southwest shore, rocky inlet, dinghy path, main gate chained"
  @typing character="kai" duration="2"
  @message id="mm_p4_f5_msg2" chat="dm_kai" sender="kai" text="southwest. not main dock. main gate is chained. remember this for later."
  @comment NEW PRIVATE DM KATHY - PART 4
  @ui open="dm_kathy"
  @online character="kathy"
  @typing character="kathy" duration="2"
  @message id="mm_p4_kathy_01" chat="dm_kathy" sender="kathy" text="I am in Sub-Level B. I found something. I cannot say it in the group."
  @typing character="kathy" duration="2"
  @message id="mm_p4_kathy_02" chat="dm_kathy" sender="kathy" text="The cells are real. I saw them. I saw the doors."
  @typing character="kathy" duration="2"
  @message id="mm_p4_kathy_03" chat="dm_kathy" sender="kathy" text="I have worked here ten years and I never knew. I never went down here."
  @typing character="kathy" duration="2"
  @message id="mm_p4_kathy_04" chat="dm_kathy" sender="kathy" text="I am going to get Jessica out. Stay on your phone. Do not let the girls follow me."
  @typing character="kathy" duration="2"
  @message id="mm_p4_kathy_05" chat="dm_kathy" sender="kathy" text="If I go quiet, tell them I am still here. Tell them I am coming back."
  @set trust_kathy +1
  @comment NEW PRIVATE DM JESSICA - PART 4
  @ui open="dm_jessica"
  @online character="jessica"
  @typing character="jessica" duration="2"
  @message id="mm_p4_jess_01" chat="dm_jessica" sender="jessica" text="hey. it is me. i got 10 seconds of signal."
  @typing character="jessica" duration="2"
  @message id="mm_p4_jess_02" chat="dm_jessica" sender="jessica" text="i did not use my card. someone cloned it. i swear."
  @typing character="jessica" duration="2"
  @message id="mm_p4_jess_03" chat="dm_jessica" sender="jessica" text="i came down because i heard the alarm. i wanted to help."
  @typing character="jessica" duration="2"
  @message id="mm_p4_jess_04" chat="dm_jessica" sender="jessica" text="tell beatrice i am sorry i snapped at her. tell her i love her. ok?"
  @set trust_jessica +1
  @comment NEW PRIVATE DM ABIGAIL - PART 4
  @ui open="dm_abigail"
  @online character="abigail"
  @typing character="abigail" duration="2"
  @message id="mm_p4_abi_01" chat="dm_abigail" sender="abigail" text="we are still in beas room. door locked. dresser against it."
  @typing character="abigail" duration="2"
  @message id="mm_p4_abi_02" chat="dm_abigail" sender="abigail" text="i keep thinking about the guy in the hallway. his face. his voice."
  @typing character="abigail" duration="2"
  @message id="mm_p4_abi_03" chat="dm_abigail" sender="abigail" text="i filmed everything because i thought no one would believe me. now i wish i had not."
  @typing character="abigail" duration="2"
  @message id="mm_p4_abi_04" chat="dm_abigail" sender="abigail" text="thank u for staying up with us. u are the only one who knows what is happening."
  @set trust_abigail +1
  @comment NEW PRIVATE DM MAYA - PART 4
  @ui open="dm_maya"
  @online character="maya"
  @typing character="maya" duration="2"
  @message id="mm_p4_maya_01" chat="dm_maya" sender="maya" text="we are still here. beas room. door locked."
  @typing character="maya" duration="2"
  @message id="mm_p4_maya_02" chat="dm_maya" sender="maya" text="i keep thinking about jessica. she said someone cloned her card."
  @typing character="maya" duration="2"
  @message id="mm_p4_maya_03" chat="dm_maya" sender="maya" text="i believe her. i do. she would not lie about that."
  @typing character="maya" duration="2"
  @message id="mm_p4_maya_04" chat="dm_maya" sender="maya" text="u are the only one who knows how scared i am. dont tell the others."
  @set trust_maya +1

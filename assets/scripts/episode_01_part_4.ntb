  @typing character="kathy" duration="2"
  @message id="mm_p4_f1_msg2" chat="dm_kathy" sender="kathy" text="two swipes. 2 mins apart. same card. one person cannot be in two places."
  @comment NEW FILE NOTE 2 - ABIGAIL HALLWAY AUDIO TRANSCRIPT

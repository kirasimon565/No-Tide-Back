  @message id="mm_p4_f3_msg" chat="dm_beatrice" sender="beatrice" text="package only. this is my room door after. the dresser moved 2 inches."
  @image id="mm_p4_f3_img" chat="dm_beatrice" sender="beatrice" file="img_beatrice_dresser_door.jpg" caption="Beatrice room door - dresser pushed against door, towels under vent, scratches on door"
  @typing character="beatrice" duration="2"
  @message id="mm_p4_f3_msg2" chat="dm_beatrice" sender="beatrice" text="see the scratches? they were not there before. he was really trying to get in."

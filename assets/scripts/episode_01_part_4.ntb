  @typing character="kai" duration="2"
  @message id="mm_p4_kai_02" chat="dm_kai" sender="kai" text="all lights went dark. then red. then dark again."
  @typing character="kai" duration="2"
  @message id="mm_p4_kai_03" chat="dm_kai" sender="kai" text="my wife keeps calling me. i told her i am staying. i am not leaving."
  @typing character="kai" duration="2"

  @image id="mm_p4_f4_img" chat="dm_mom" sender="mom" file="doc_mom_kitchen_note.jpg" caption="Mom kitchen note - pharmacy, milk, frozen pizza, love mom"
  @typing character="mom" duration="2"
  @message id="mm_p4_f4_msg2" chat="dm_mom" sender="mom" text="i wrote pharmacy, milk, pizza. normal stuff. while you were saving your friends."

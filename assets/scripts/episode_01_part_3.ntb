@message id="m134c" chat="dm_kai" sender="kai" text="engine is on. i am not going anywhere"
@typing character="kai" duration="3"
@message id="m134b" chat="dm_kai" sender="kai" text="plus my youngest leo would never forgive me if i bailed on a boat trip. hes been talking about this boat for weeks."
@comment NEW
@typing character="kai" duration="2"
@message id="m134b2" chat="dm_kai" sender="kai" text="leo keeps asking about this boat. he draws it every day"
@comment NEW
@typing character="kai" duration="2"
@message id="m134b3" chat="dm_kai" sender="kai" text="i promised him a ride when i get back. i keep my promises"
@comment NEW
@typing character="kai" duration="2"
@message id="m134b4" chat="dm_kai" sender="kai" text="he is 6. he thinks i am a superhero. i cant let him down"
@typing character="kai" duration="3"
@message id="m135" chat="dm_kai" sender="kai" text="one problem tho, two armed guards just walked down to the main pier and chained the harbor gate shut from the inside."
@comment NEW
@typing character="kai" duration="2"
@message id="m135a" chat="dm_kai" sender="kai" text="two guards. armed. they chained the gate. from inside"
@comment NEW
@typing character="kai" duration="2"
@message id="m135b" chat="dm_kai" sender="kai" text="i watched them do it. they did not even look at me"
@comment NEW
@typing character="kai" duration="2"
@message id="m135c" chat="dm_kai" sender="kai" text="that gate is the only way in and out by boat. now it is locked"
@typing character="kai" duration="2"
@message id="m136" chat="dm_kai" sender="kai" text="if ur friends have to leave in a hurry they wont be able to use the main dock. tell them theres an old rocky inlet on the southwest shore i can pull a dinghy into."
@comment NEW
@typing character="kai" duration="2"
@message id="m136a" chat="dm_kai" sender="kai" text="southwest shore. rocky inlet. not the main dock"
@comment NEW
@typing character="kai" duration="2"
@message id="m136b" chat="dm_kai" sender="kai" text="i can pull a dinghy in there. it is tight but i can do it"
@comment NEW
@typing character="kai" duration="2"
@message id="m136c" chat="dm_kai" sender="kai" text="tell them. when they need it. southwest. remember that"
@add_evidence id="ev_southwest_inlet" title="Kai's Extraction Tip" description="Main harbor gate is chained shut. Kai can get the group out via the rocky southwest inlet."
@offline character="kai"

@delay seconds="2"
@sound file="notification_chime.mp3"
@notification chat="group_island" sender="Kathy" text="Lockdown lifted. Corridor is clear."

@comment LOCKDOWN LIFTED AND KATHY REPORT
@ui open="group_island"
@online character="kathy"
@online character="beatrice"
@online character="abigail"
@online character="maya"

@typing character="kathy" duration="2"
@message id="m137" chat="group_island" sender="kathy" text="Lockdown lifted. Hallway is clear."
@comment NEW
@typing character="kathy" duration="2"
@message id="m137a" chat="group_island" sender="kathy" text="Lockdown lifted. You can open your doors now."
@comment NEW
@typing character="kathy" duration="2"
@message id="m137b" chat="group_island" sender="kathy" text="Hallway is clear. I checked it myself."
@comment NEW
@typing character="kathy" duration="2"
@message id="m137c" chat="group_island" sender="kathy" text="Wristbands should go back to green in a minute."
@typing character="beatrice" duration="2"
@message id="m138" chat="group_island" sender="beatrice" text="what about jessica?! was she in her room?"
@comment NEW
@typing character="beatrice" duration="2"
@message id="m138a" chat="group_island" sender="beatrice" text="was she in there? did u check?"
@comment NEW
@typing character="beatrice" duration="2"
@message id="m138b" chat="group_island" sender="beatrice" text="pls tell me she was just sleeping and missed all this"
@comment NEW
@typing character="beatrice" duration="2"
@message id="m138c" chat="group_island" sender="beatrice" text="kathy. answer. was she in her room?"

@typing character="kathy" duration="3"
@message id="m139" chat="group_island" sender="kathy" text="Her room was empty. Bed untouched."
@comment NEW
@typing character="kathy" duration="2"
@message id="m139a" chat="group_island" sender="kathy" text="Bed untouched. No phone. No tablet. Nothing."
@comment NEW
@typing character="kathy" duration="2"
@message id="m139b" chat="group_island" sender="kathy" text="Her bag is still there. Her jacket is gone."
@comment NEW
@typing character="kathy" duration="2"
@message id="m139c" chat="group_island" sender="kathy" text="She did not pack. She just left."
@typing character="abigail" duration="2"
@message id="m140" chat="group_island" sender="abigail" text="what?! where the hell is she?!"
@comment NEW
@typing character="abigail" duration="2"
@message id="m140a" chat="group_island" sender="abigail" text="where is she? she cant just vanish"
@comment NEW
@typing character="abigail" duration="2"
@message id="m140b" chat="group_island" sender="abigail" text="she was supposed to be sleeping. she said she was going to sleep"
@comment NEW
@typing character="abigail" duration="2"
@message id="m140c" chat="group_island" sender="abigail" text="i am gonna cry. i am actually gonna cry"

@typing character="kathy" duration="3"
@message id="m141" chat="group_island" sender="kathy" text="Security logs show her keycard used the Sub-Level B elevator ten minutes before the alarm went off."
@comment NEW
@typing character="kathy" duration="2"
@message id="m141a" chat="group_island" sender="kathy" text="Logs do not lie. Her keycard. Sub-Level B elevator. 10 mins before alarm."
@comment NEW
@typing character="kathy" duration="2"
@message id="m141b" chat="group_island" sender="kathy" text="I checked twice. Same time. Same card."
@comment NEW
@typing character="kathy" duration="2"
@message id="m141c" chat="group_island" sender="kathy" text="I did not authorize that. No one did."
@typing character="maya" duration="2"
@message id="m142" chat="group_island" sender="maya" text="sub-level b?! thats the floor u told us was totally off limits!"
@comment NEW
@typing character="maya" duration="2"
@message id="m142a" chat="group_island" sender="maya" text="u told us not to go there. ever. u said red markers"
@comment NEW
@typing character="maya" duration="2"
@message id="m142b" chat="group_island" sender="maya" text="why would jessica go there? she knows the rules"
@comment NEW
@typing character="maya" duration="2"
@message id="m142c" chat="group_island" sender="maya" text="unless someone made her go. unless someone took her"

@typing character="kathy" duration="3"
@message id="m143" chat="group_island" sender="kathy" text="It is. And the guard down there is in the infirmary right now, says a wild animal broke through the fence and attacked him."
@comment NEW
@typing character="kathy" duration="2"
@message id="m143a" chat="group_island" sender="kathy" text="Guard is in infirmary. He says an animal broke through the fence."
@comment NEW
@typing character="kathy" duration="2"
@message id="m143b" chat="group_island" sender="kathy" text="He has scratches on his arm. He is shaken. Not badly hurt."
@comment NEW
@typing character="kathy" duration="2"
@message id="m143c" chat="group_island" sender="kathy" text="I have not seen the animal. Security has not found it."
@typing character="kathy" duration="3"
@message id="m144" chat="group_island" sender="kathy" text="Im going down to Sub-Level B myself to find her. Nobody leaves this floor."
@comment NEW
@typing character="kathy" duration="2"
@message id="m144a" chat="group_island" sender="kathy" text="I am going down myself. No one else. Just me."
@comment NEW
@typing character="kathy" duration="2"
@message id="m144b" chat="group_island" sender="kathy" text="Nobody leaves this floor. Stay in your rooms. Lock your doors."
@comment NEW
@typing character="kathy" duration="2"
@message id="m144c" chat="group_island" sender="kathy" text="I will text when I find her. Stay put."

@choice id="c024"
  @choice_locked id="c024_prem" cost="20" text="[PREMIUM - 20 Coins] Message Kathy privately before she goes into Sub-Level B: warn her B.H. is hiding human experiments."
    @set kathy_warned_ep1 = true
    @set trust_kathy +2
    @goto ep1_kathy_prem_dm
  @reply text="be careful down there kathy. bring them all back in one piece."
    @set kathy_warned_ep1 = false
    @goto ep1_part4_climax

:: ep1_kathy_prem_dm
@ui open="dm_kathy"
@online character="kathy"
@typing character="kathy" duration="2"
@message id="m145" chat="dm_kathy" sender="kathy" text="Speak fast {player_name}. Im standing at the Sub-Level B elevator rn."
@comment NEW
@typing character="kathy" duration="2"
@message id="m145a" chat="dm_kathy" sender="kathy" text="Elevator is here. Doors open. I have 30 seconds"
@comment NEW
@typing character="kathy" duration="2"
@message id="m145b" chat="dm_kathy" sender="kathy" text="Talk fast. What do u need to tell me?"
@comment NEW
@typing character="kathy" duration="2"
@message id="m145c" chat="dm_kathy" sender="kathy" text="If this is about the lockdown, I already know"
@typing character="kathy" duration="3"
@message id="m146" chat="dm_kathy" sender="kathy" text="What do u mean 'human experiments'? Ive worked for B.H. for ten years, they make medical supplies."
@comment NEW
@typing character="kathy" duration="2"
@message id="m146a" chat="dm_kathy" sender="kathy" text="Ten years. Medical supplies. That is what they told me"
@comment NEW
@typing character="kathy" duration="2"
@message id="m146b" chat="dm_kathy" sender="kathy" text="Human experiments? That is a big claim. U better have proof"
@comment NEW
@typing character="kathy" duration="2"
@message id="m146c" chat="dm_kathy" sender="kathy" text="I am standing at the elevator. My hand is shaking. Talk"

@choice id="c025"
  @reply text="We have camera footage of hazmat teams wheeling a bleeding tied up person into Sub-Level B tonight. Check the cells."
    @goto ep1_kathy_prem_reply

:: ep1_kathy_prem_reply
@typing character="kathy" duration="3"
@message id="m147" chat="dm_kathy" sender="kathy" text="...If ur lying to me {player_name}, I'll have ur access cut before morning."
@comment NEW
@typing character="kathy" duration="2"
@message id="m147a" chat="dm_kathy" sender="kathy" text="If u are lying, I will cut your access. I mean it"
@comment NEW
@typing character="kathy" duration="2"
@message id="m147b" chat="dm_kathy" sender="kathy" text="I do not like being played. Especially not tonight"
@comment NEW
@typing character="kathy" duration="2"
@message id="m147c" chat="dm_kathy" sender="kathy" text="But if u are telling the truth, I need to know what I am walking into"
@typing character="kathy" duration="3"
@message id="m148" chat="dm_kathy" sender="kathy" text="If ur telling the truth... God help whoever signed off on this. Keep ur phone close."
@comment NEW
@typing character="kathy" duration="2"
@message id="m148a" chat="dm_kathy" sender="kathy" text="Keep your phone close. I will text you from down there"
@comment NEW
@typing character="kathy" duration="2"
@message id="m148b" chat="dm_kathy" sender="kathy" text="If I go quiet, tell the girls to stay in their rooms. Do not let them follow me"
@comment NEW
@typing character="kathy" duration="2"
@message id="m148c" chat="dm_kathy" sender="kathy" text="Going down now. Elevator doors closing"
@offline character="kathy"

@comment MULTIMEDIA PACKAGE - PART 3 - OPTIONAL - DOES NOT COUNT IN 700
@if multimedia_package_owned == true
  @system_message chat="system" text="MULTIMEDIA PACKAGE: 5 file notes and 5 private DMs unlocked for Part 3"

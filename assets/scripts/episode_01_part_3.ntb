  @ui open="dm_beatrice"
  @typing character="beatrice" duration="2"
  @message id="mm_p3_f1_msg" chat="dm_beatrice" sender="beatrice" text="package only. my notes from Wing A. i wrote them on my phone so no one sees my paper notes."
  @image id="mm_p3_f1_img" chat="dm_beatrice" sender="beatrice" file="doc_beatrice_wing_a_notes.jpg" caption="Beatrice Wing A notes - cooler labels, aerosol chemicals list, timestamp 18:42"
  @typing character="beatrice" duration="2"
  @message id="mm_p3_f1_msg2" chat="dm_beatrice" sender="beatrice" text="i wrote down the cooler labels exactly. i did not want to forget the names."
  @comment NEW FILE NOTE 2 - KATHY SECURITY LOG SNIPPET
  @ui open="dm_kathy"
  @typing character="kathy" duration="2"
  @message id="mm_p3_f2_msg" chat="dm_kathy" sender="kathy" text="package only. this is the security log snippet. keycard, elevator, time."
  @image id="mm_p3_f2_img" chat="dm_kathy" sender="kathy" file="doc_kathy_security_log_snippet.jpg" caption="Security log - keycard swipe Sub-Level B elevator, 23:54, ID redacted"
  @typing character="kathy" duration="2"
  @message id="mm_p3_f2_msg2" chat="dm_kathy" sender="kathy" text="i should not be sharing this. but you asked. the time is 23:54."
  @comment NEW FILE NOTE 3 - ABIGAIL WRISTBAND PHOTO
  @ui open="dm_abigail"
  @typing character="abigail" duration="2"
  @message id="mm_p3_f3_msg" chat="dm_abigail" sender="abigail" text="package only. my wristband. it is still red in this pic."
  @image id="mm_p3_f3_img" chat="dm_abigail" sender="abigail" file="img_abigail_wristband_red.jpg" caption="Abigail wristband flashing red, 00:04 AM, door locked"
  @typing character="abigail" duration="2"
  @message id="mm_p3_f3_msg2" chat="dm_abigail" sender="abigail" text="i took this at 00:04. my door was locked. my band was red. i was scared."
  @comment NEW FILE NOTE 4 - KAI BINOCULAR PHOTO
  @ui open="dm_kai"
  @typing character="kai" duration="2"
  @message id="mm_p3_f4_msg" chat="dm_kai" sender="kai" text="package only. i took this through my binoculars. it is blurry but you can see the red lights."
  @image id="mm_p3_f4_img" chat="dm_kai" sender="kai" file="img_kai_binocular_red_lights.jpg" caption="Island through binoculars - all windows red, 00:12 AM, south cove"
  @typing character="kai" duration="2"
  @message id="mm_p3_f4_msg2" chat="dm_kai" sender="kai" text="all red. every window. i have never seen that in 12 years."
  @comment NEW FILE NOTE 5 - MAYA VENT PHOTO
  @ui open="dm_maya"
  @typing character="maya" duration="2"
  @message id="mm_p3_f5_msg" chat="dm_maya" sender="maya" text="package only. this is the vent outside my door. i took it before lockdown."
  @image id="mm_p3_f5_img" chat="dm_maya" sender="maya" file="img_maya_vent_hallway.jpg" caption="Maya hallway vent - metal vent, scratches, hallway B, 23:58"
  @typing character="maya" duration="2"
  @message id="mm_p3_f5_msg2" chat="dm_maya" sender="maya" text="see the scratches? they were not there in the morning. i checked."
  @comment NEW PRIVATE DM KATHY - PART 3
  @ui open="dm_kathy"
  @online character="kathy"
  @typing character="kathy" duration="2"
  @message id="mm_p3_kathy_01" chat="dm_kathy" sender="kathy" text="I am about to go down. Can I tell you something first?"
  @typing character="kathy" duration="2"
  @message id="mm_p3_kathy_02" chat="dm_kathy" sender="kathy" text="I have been in the military. I have seen lockdowns. This one felt different."
  @typing character="kathy" duration="2"
  @message id="mm_p3_kathy_03" chat="dm_kathy" sender="kathy" text="The doors locked from outside. Not from inside. That is not standard."
  @typing character="kathy" duration="2"
  @message id="mm_p3_kathy_04" chat="dm_kathy" sender="kathy" text="I did not tell the girls that. I did not want them to panic more."
  @typing character="kathy" duration="2"
  @message id="mm_p3_kathy_05" chat="dm_kathy" sender="kathy" text="If I do not come back in 20 mins, tell them to stay put. Do not let them follow me."
  @set trust_kathy +1
  @comment NEW PRIVATE DM JESSICA - PART 3 - NOTE: JESSICA IS MISSING, THIS IS HER LAST NOTE FROM EARLIER
  @ui open="dm_jessica"
  @online character="jessica"
  @typing character="jessica" duration="2"
  @message id="mm_p3_jess_01" chat="dm_jessica" sender="jessica" text="hey. if you are reading this in the package, this is from earlier today."
  @typing character="jessica" duration="2"
  @message id="mm_p3_jess_02" chat="dm_jessica" sender="jessica" text="i wrote this before dinner. i was in Wing A and the coolers were weird."
  @typing character="jessica" duration="2"
  @message id="mm_p3_jess_03" chat="dm_jessica" sender="jessica" text="i told beatrice the logs were off. i did not tell her why. i was scared."
  @typing character="jessica" duration="2"
  @message id="mm_p3_jess_04" chat="dm_jessica" sender="jessica" text="i just wanted to do my job and get paid and go home to my mom. that is all i wanted."
  @set trust_jessica +1
  @comment NEW PRIVATE DM ABIGAIL - PART 3
  @ui open="dm_abigail"
  @online character="abigail"
  @typing character="abigail" duration="2"
  @message id="mm_p3_abi_01" chat="dm_abigail" sender="abigail" text="my wristband is still red. i keep staring at it."
  @typing character="abigail" duration="2"
  @message id="mm_p3_abi_02" chat="dm_abigail" sender="abigail" text="i am locked in. door locked. lights off. i am under my blanket again."
  @typing character="abigail" duration="2"
  @message id="mm_p3_abi_03" chat="dm_abigail" sender="abigail" text="i keep thinking about the gurney. and the black jacket. and jessica."
  @typing character="abigail" duration="2"
  @message id="mm_p3_abi_04" chat="dm_abigail" sender="abigail" text="i do not want to think jessica did it. i really do not. she is my friend."
  @set trust_abigail +1
  @comment NEW PRIVATE DM MAYA - PART 3
  @ui open="dm_maya"
  @online character="maya"
  @typing character="maya" duration="2"
  @message id="mm_p3_maya_01" chat="dm_maya" sender="maya" text="i am still on the floor. i have not moved."
  @typing character="maya" duration="2"
  @message id="mm_p3_maya_02" chat="dm_maya" sender="maya" text="i keep hearing boots. then nothing. then boots again."
  @typing character="maya" duration="2"
  @message id="mm_p3_maya_03" chat="dm_maya" sender="maya" text="i want to text jessica but she is not answering. i am scared she is gone."
  @typing character="maya" duration="2"
  @message id="mm_p3_maya_04" chat="dm_maya" sender="maya" text="u are the only one i can tell this to. i am not okay. i am really not okay."
  @set trust_maya +1
  @comment NEW PRIVATE DM KAI - PART 3
  @ui open="dm_kai"
  @online character="kai"
  @typing character="kai" duration="2"
  @message id="mm_p3_kai_01" chat="dm_kai" sender="kai" text="i am still here. engine on. lights red on the island."
  @typing character="kai" duration="2"
  @message id="mm_p3_kai_02" chat="dm_kai" sender="kai" text="my wife texted me. she said come home. i told her i cant."
  @typing character="kai" duration="2"
  @message id="mm_p3_kai_03" chat="dm_kai" sender="kai" text="leo drew a picture of my boat today. he sent it to me. i have it on my phone."
  @typing character="kai" duration="2"
  @message id="mm_p3_kai_04" chat="dm_kai" sender="kai" text="i am not leaving. southwest inlet. remember that. if they need me, i am there."
  @set trust_kai +1
@endif


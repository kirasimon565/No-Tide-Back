@comment MULTIMEDIA PACKAGE - PART 2 - OPTIONAL - DOES NOT COUNT IN 700
@if multimedia_package_owned == true
  @system_message chat="system" text="MULTIMEDIA PACKAGE: 5 file notes and 5 private DMs unlocked for Part 2"
  @comment NEW FILE NOTE 1 - ABIGAIL CAMERA SETTINGS
  @ui open="dm_abigail"
  @typing character="abigail" duration="2"
  @message id="mm_p2_f1_msg" chat="dm_abigail" sender="abigail" text="package only. this is what my camera was set to that night. iso 6400, shutter 1/60."
  @image id="mm_p2_f1_img" chat="dm_abigail" sender="abigail" file="doc_abigail_camera_settings.jpg" caption="Abigail camera settings - night mode, lens 50mm, timestamp 22:48, battery 12 percent"
  @typing character="abigail" duration="2"
  @message id="mm_p2_f1_msg2" chat="dm_abigail" sender="abigail" text="my battery was at 12 percent. that is why it glitched so fast. not just the jammer."
  @comment NEW FILE NOTE 2 - CHLOE REGISTRY SCREENSHOT
  @ui open="dm_sister"
  @typing character="sister" duration="2"
  @message id="mm_p2_f2_msg" chat="dm_sister" sender="sister" text="package only. this is the registry page i found. i screenshot it before it vanished."
  @image id="mm_p2_f2_img" chat="dm_sister" sender="sister" file="doc_chloe_registry_screenshot.jpg" caption="Offshore registry - B.H. parent company listed, board members redacted, page cached 11:31 PM"
  @typing character="sister" duration="2"
  @message id="mm_p2_f2_msg2" chat="dm_sister" sender="sister" text="see the board list? three names are blacked out. i did not black them out. they were already like that."
  @comment NEW FILE NOTE 3 - KAI WEATHER LOG
  @ui open="dm_kai"
  @typing character="kai" duration="2"
  @message id="mm_p2_f3_msg" chat="dm_kai" sender="kai" text="package only. my weather log for tonight. wind calm, sea calm, no storm."
  @image id="mm_p2_f3_img" chat="dm_kai" sender="kai" file="doc_kai_weather_log.jpg" caption="Kai weather log - wind 4 knots, sea state calm, visibility 2 miles, anchor position south cove"
  @typing character="kai" duration="2"
  @message id="mm_p2_f3_msg2" chat="dm_kai" sender="kai" text="no storm tonight. so if the power flickered, it was not weather."
  @comment NEW FILE NOTE 4 - KATHY CURFEW LOG
  @ui open="dm_kathy"
  @typing character="kathy" duration="2"
  @message id="mm_p2_f4_msg" chat="dm_kathy" sender="kathy" text="package only. my curfew check log. i do this every night at 22:00."
  @image id="mm_p2_f4_img" chat="dm_kathy" sender="kathy" file="doc_kathy_curfew_log.jpg" caption="Kathy curfew log - all rooms checked 22:00, hallway B clear, east door locked"
  @typing character="kathy" duration="2"
  @message id="mm_p2_f4_msg2" chat="dm_kathy" sender="kathy" text="at 22:00 everything was clear. something changed after midnight."
  @comment NEW FILE NOTE 5 - JESSICA MOM BILL REDACTED
  @ui open="dm_jessica"
  @typing character="jessica" duration="2"
  @message id="mm_p2_f5_msg" chat="dm_jessica" sender="jessica" text="package only. this is the hospital letter. i blacked out the amounts. i do not want pity."
  @image id="mm_p2_f5_img" chat="dm_jessica" sender="jessica" file="doc_jessica_hospital_letter.jpg" caption="Hospital letter - treatment schedule, amounts redacted, next appointment next week"
  @typing character="jessica" duration="2"
  @message id="mm_p2_f5_msg2" chat="dm_jessica" sender="jessica" text="i just want people to know i am not making it up. it is real. it is a lot."
  @comment NEW PRIVATE DM KATHY - PART 2
  @ui open="dm_kathy"
  @online character="kathy"
  @typing character="kathy" duration="2"
  @message id="mm_p2_kathy_01" chat="dm_kathy" sender="kathy" text="Can I ask you something off the record?"
  @typing character="kathy" duration="2"
  @message id="mm_p2_kathy_02" chat="dm_kathy" sender="kathy" text="I have worked for B.H. for ten years. I have never seen wristbands go red like that."
  @typing character="kathy" duration="2"
  @message id="mm_p2_kathy_03" chat="dm_kathy" sender="kathy" text="Red used to mean medical emergency. Now it means stay inside. They changed the manual last month."
  @typing character="kathy" duration="2"
  @message id="mm_p2_kathy_04" chat="dm_kathy" sender="kathy" text="I did not get a memo about why. I just got the new manual."
  @typing character="kathy" duration="2"
  @message id="mm_p2_kathy_05" chat="dm_kathy" sender="kathy" text="Do not tell the girls I am worried. I need them to think I have a plan."
  @set trust_kathy +1
  @comment NEW PRIVATE DM JESSICA - PART 2
  @ui open="dm_jessica"
  @online character="jessica"
  @typing character="jessica" duration="2"
  @message id="mm_p2_jess_01" chat="dm_jessica" sender="jessica" text="hey. sorry i was weird at dinner."
  @typing character="jessica" duration="2"
  @message id="mm_p2_jess_02" chat="dm_jessica" sender="jessica" text="my mom called and the hospital said the new treatment might work but it is expensive."
  @typing character="jessica" duration="2"
  @message id="mm_p2_jess_03" chat="dm_jessica" sender="jessica" text="i went to the north courtyard to get signal because the hallway has dead zones."
  @typing character="jessica" duration="2"
  @message id="mm_p2_jess_04" chat="dm_jessica" sender="jessica" text="i was not hiding. i was just trying to hear my mom's doctor without crying in front of everyone."
  @set trust_jessica +1
  @comment NEW PRIVATE DM ABIGAIL - PART 2
  @ui open="dm_abigail"
  @online character="abigail"
  @typing character="abigail" duration="2"
  @message id="mm_p2_abi_01" chat="dm_abigail" sender="abigail" text="u know what is weird? i film everything because i am scared i will forget."
  @typing character="abigail" duration="2"
  @message id="mm_p2_abi_02" chat="dm_abigail" sender="abigail" text="my dad used to film everything too. he said if u have it on camera, no one can say u made it up."
  @typing character="abigail" duration="2"
  @message id="mm_p2_abi_03" chat="dm_abigail" sender="abigail" text="tonight i filmed something and i still feel like no one will believe me."
  @typing character="abigail" duration="2"
  @message id="mm_p2_abi_04" chat="dm_abigail" sender="abigail" text="thank u for believing me. even when the frame was messed up."
  @set trust_abigail +1
  @comment NEW PRIVATE DM MAYA - PART 2
  @ui open="dm_maya"
  @online character="maya"
  @typing character="maya" duration="2"
  @message id="mm_p2_maya_01" chat="dm_maya" sender="maya" text="hey. i am still awake. i cant sleep after that scratching sound."
  @typing character="maya" duration="2"
  @message id="mm_p2_maya_02" chat="dm_maya" sender="maya" text="i keep thinking about the vents. what if it is an animal? what if it is not?"
  @typing character="maya" duration="2"
  @message id="mm_p2_maya_03" chat="dm_maya" sender="maya" text="u are the only one who knows how scared i get at night. i used to sleep with the light on at my aunt's house."
  @typing character="maya" duration="2"
  @message id="mm_p2_maya_04" chat="dm_maya" sender="maya" text="dont tell the others i am scared. i need to look okay for them."
  @set trust_maya +1
  @comment NEW PRIVATE DM KAI - PART 2
  @ui open="dm_kai"
  @online character="kai"
  @typing character="kai" duration="2"
  @message id="mm_p2_kai_01" chat="dm_kai" sender="kai" text="u still up? i saw the lights flicker from the boat."
  @typing character="kai" duration="2"
  @message id="mm_p2_kai_02" chat="dm_kai" sender="kai" text="from out here the whole building flickered. just for a sec. then it went back."
  @typing character="kai" duration="2"
  @message id="mm_p2_kai_03" chat="dm_kai" sender="kai" text="my kids ask me why i stay out here at night. i tell them it is because someone has to watch the water."
  @typing character="kai" duration="2"
  @message id="mm_p2_kai_04" chat="dm_kai" sender="kai" text="i am watching. engine on. if your friends need me, i am here."
  @set trust_kai +1
@endif


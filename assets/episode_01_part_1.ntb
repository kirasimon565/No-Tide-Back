  @ui open="dm_jessica"
  @typing character="jessica" duration="2"
  @message id="mm_p1_f4_msg" chat="dm_jessica" sender="jessica" text="my prep note from today. i wrote it at 3am because i could not sleep."
  @image id="mm_p1_f4_img" chat="dm_jessica" sender="jessica" file="doc_jessica_prep_note.jpg" caption="Jessica Prep Note - centrifuge check, water tastes metallic, 12 vials off last time"
  @typing character="jessica" duration="2"
  @message id="mm_p1_f4_msg2" chat="dm_jessica" sender="jessica" text="the water here tastes metallic. i wrote that down because i thought i was tired. maybe i was not."

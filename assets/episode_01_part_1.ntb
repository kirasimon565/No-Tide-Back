  @image id="mm_p1_f5_img" chat="dm_maya" sender="maya" file="doc_maya_mockup_blue.jpg" caption="Maya Mockup - B.H. branding, blue and white, file metadata timestamp 02:14 AM"
  @typing character="maya" duration="2"
  @message id="mm_p1_f5_msg2" chat="dm_maya" sender="maya" text="i was up late finishing it. bh kept asking for changes at 2am. weird hours for branding, right?"
  @comment NEW PRIVATE DM KATHY
  @ui open="dm_kathy"
  @online character="kathy"
  @typing character="kathy" duration="2"
  @message id="mm_p1_kathy_01" chat="dm_kathy" sender="kathy" text="Can I be honest for a minute? Not as your manager. Just as Kathy."
  @typing character="kathy" duration="2"
  @message id="mm_p1_kathy_02" chat="dm_kathy" sender="kathy" text="I run a tight site because I have seen what happens when people ignore protocol."
  @typing character="kathy" duration="2"
  @message id="mm_p1_kathy_03" chat="dm_kathy" sender="kathy" text="I lost two people in my military years because someone went past a marker to take a photo."
  @typing character="kathy" duration="2"
  @message id="mm_p1_kathy_04" chat="dm_kathy" sender="kathy" text="I took this B.H. job because I wanted a quiet corporate job after that. No field work. Just paperwork."
  @typing character="kathy" duration="2"
  @message id="mm_p1_kathy_05" chat="dm_kathy" sender="kathy" text="Ten years here. I thought I knew this company. I am starting to wonder if I did."
  @typing character="kathy" duration="2"
  @message id="mm_p1_kathy_06" chat="dm_kathy" sender="kathy" text="Do not tell the girls I said that. I need them to trust that I have it under control."
  @set kathy_trust_up = true
  @set trust_kathy +1

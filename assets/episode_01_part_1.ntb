@version 1.0
@metadata title="No Tide Back - Episode 1: The Contract" author="EyesWatching Games" episode="1"
@comment EXPANDED PART 1 - ORIGINAL 84 MESSAGES + 91 NEW = 175 MAIN MESSAGES
@comment SEARCH FOR NEW TO SEE ALL ADDED LINES

@set trust_jessica = 5
@set trust_abigail = 7
@set trust_beatrice = 6
@set trust_maya = 7
@set trust_kathy = 3
@set trust_kai = 4
@set home_safe = true
@set evidence_count = 0
@set maya_photo_clue = false
@set sister_suspicious = false
@set suspicion = 0
@set stress = 0
@set multimedia_package_owned = false
@set kathy_trust_up = false
@set kai_trust_up = false

@character id="jessica" name="Jessica" avatar="avatar_jessica.png" status="Online"
@character id="abigail" name="Abigail" avatar="avatar_abigail.png" status="Online"
@character id="beatrice" name="Beatrice" avatar="avatar_beatrice.png" status="Online"

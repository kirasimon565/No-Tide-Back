  @ui open="dm_jessica"
  @online character="jessica"
  @typing character="jessica" duration="2"
  @message id="mm_p1_jess_01" chat="dm_jessica" sender="jessica" text="can i tell u something i did not say in the group?"
  @typing character="jessica" duration="2"
  @message id="mm_p1_jess_02" chat="dm_jessica" sender="jessica" text="my mom's new treatment is 40k. my old lab still owes me money and they will not pay."
  @typing character="jessica" duration="2"
  @message id="mm_p1_jess_03" chat="dm_jessica" sender="jessica" text="i snapped at beatrice today because i am scared. not because she did anything wrong."
  @typing character="jessica" duration="2"
  @message id="mm_p1_jess_04" chat="dm_jessica" sender="jessica" text="i love her. she is like family. i just do not know how to say i am scared without sounding weak."
  @set trust_jessica +1
  @comment NEW PRIVATE DM ABIGAIL
  @ui open="dm_abigail"
  @online character="abigail"
  @typing character="abigail" duration="2"
  @message id="mm_p1_abi_01" chat="dm_abigail" sender="abigail" text="u know why i film everything? my dad used to do it. he said photos dont lie."
  @typing character="abigail" duration="2"
  @message id="mm_p1_abi_02" chat="dm_abigail" sender="abigail" text="i watch ahs and i read crime and punishment and everyone thinks it is just a phase."
  @typing character="abigail" duration="2"
  @message id="mm_p1_abi_03" chat="dm_abigail" sender="abigail" text="it is not a phase. i am obsessed with guilt. like what guilt does to people. how it makes them do weird things."
  @typing character="abigail" duration="2"
  @message id="mm_p1_abi_04" chat="dm_abigail" sender="abigail" text="that is why tonight scared me so much. i saw something real and i have no idea what to do with it."
  @set trust_abigail +1
  @comment NEW PRIVATE DM MAYA
  @ui open="dm_maya"
  @online character="maya"
  @typing character="maya" duration="2"
  @message id="mm_p1_maya_01" chat="dm_maya" sender="maya" text="hey. can i tell u something? just u. not the group."
  @typing character="maya" duration="2"
  @message id="mm_p1_maya_02" chat="dm_maya" sender="maya" text="i lost my parents when i was 15. u know that. but i never told anyone how it happened."
  @typing character="maya" duration="2"
  @message id="mm_p1_maya_03" chat="dm_maya" sender="maya" text="car crash. at night. no one saw it. police said it was an accident. i never believed that."
  @typing character="maya" duration="2"
  @message id="mm_p1_maya_04" chat="dm_maya" sender="maya" text="i lived with my aunt after that. u and beatrice were the only family i had left. u know that too."
  @typing character="maya" duration="2"
  @message id="mm_p1_maya_05" chat="dm_maya" sender="maya" text="bh said they could help me find the truth. that is why i took this job. i just want to know what happened to them."
  @set trust_maya +1
  @comment NEW PRIVATE DM KAI
  @ui open="dm_kai"
  @online character="kai"
  @typing character="kai" duration="2"
  @message id="mm_p1_kai_01" chat="dm_kai" sender="kai" text="u asked about my family earlier. i will tell u a bit more."
  @typing character="kai" duration="2"
  @message id="mm_p1_kai_02" chat="dm_kai" sender="kai" text="my wife is a teacher. she hates this job. she says the pay is too good to be clean."
  @typing character="kai" duration="2"
  @message id="mm_p1_kai_03" chat="dm_kai" sender="kai" text="my oldest is 9. my youngest Leo is 6. Leo draws boats all day. he wants to be a captain like me."
  @typing character="kai" duration="2"
  @message id="mm_p1_kai_04" chat="dm_kai" sender="kai" text="i told them i would be home in 5 days. i keep my promises. so i will be here when your friends need me."

@typing character="kathy" duration="4"
@message id="m045" chat="group_island" sender="kathy" text="Before you unpack, three rules: 1) Wear your biometric wristbands at all times. 2) Do not enter Sub-Level B or the East Perimeter past the red markers. 3) Curfew is 22:00 sharp."
@comment NEW
@typing character="kathy" duration="2"
